{
    "description": "add_node_at refuses a user who is in the matrix holding tank with USER_IN_HOLDING_TANK",
    "setup": [
        {"id": "s-1", "op": "create_tree", "params": {"structure": "test", "tree_type": "matrix", "width": 2, "spillover": "breadth_first"}},
        {"id": "s-2", "op": "add_root", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 1000}},
        {"id": "s-3", "op": "add_node_at", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000002", "sponsor_id": "00000000-0000-0000-0000-000000000001", "parent_id": "00000000-0000-0000-0000-000000000001", "position": 0, "enrolled_at": 2000}},
        {"id": "s-4", "op": "remove_node", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000002", "pruning_mode": "holding_tank"}}
    ],
    "request": {
        "id": "ht-1",
        "op": "add_node_at",
        "params": {
            "structure": "test",
            "user_id": "00000000-0000-0000-0000-000000000002",
            "sponsor_id": "00000000-0000-0000-0000-000000000001",
            "parent_id": "00000000-0000-0000-0000-000000000001",
            "position": 0,
            "enrolled_at": 3000
        }
    },
    "expected_response": {"id": "ht-1", "ok": false, "error": {"code": "USER_IN_HOLDING_TANK", "message_contains": "holding tank"}}
}
