{
    "description": "board_dissolve refuses a board whose positions are all filled, with BOARD_FULL, and the message reports the filled and total counts it read. Cross-language lock for the code protocol 13 added. Setup restores a 2x1 board plan by hand, because no public operation is guaranteed to leave a board full. The payload spells out the BoardPlanEngine shape, so a new required field fails setup rather than reaching the request.",
    "setup": [
        {
            "id": "bdf-s1",
            "op": "restore_snapshot",
            "params": {
                "structure": "FullBoards",
                "tree_type": "board_plan",
                "data": {
                    "width": 2,
                    "height": 1,
                    "total_positions": 3,
                    "boards": {
                        "aaaaaaaa-0000-0000-0000-000000000001": {
                            "id": "aaaaaaaa-0000-0000-0000-000000000001",
                            "positions": [
                                "cccccccc-0000-0000-0000-000000000001",
                                "cccccccc-0000-0000-0000-000000000002",
                                "cccccccc-0000-0000-0000-000000000003"
                            ],
                            "created_at": 1,
                            "seq": 0,
                            "last_activity_at": 1,
                            "parent_board_id": null
                        }
                    },
                    "member_boards": {
                        "cccccccc-0000-0000-0000-000000000001": "aaaaaaaa-0000-0000-0000-000000000001",
                        "cccccccc-0000-0000-0000-000000000002": "aaaaaaaa-0000-0000-0000-000000000001",
                        "cccccccc-0000-0000-0000-000000000003": "aaaaaaaa-0000-0000-0000-000000000001"
                    },
                    "sponsor_map": {},
                    "displaced_members": [],
                    "next_board_seq": 1,
                    "config": {
                        "cycle_commission": 500.0,
                        "re_entry_enabled": true,
                        "re_entry_position": "bottom",
                        "max_cycles_per_period": 4,
                        "max_cascade_depth": 1,
                        "stall_threshold_periods": 3,
                        "inactive_compression": false
                    }
                }
            }
        }
    ],
    "request": {
        "id": "bdf-1",
        "op": "board_dissolve",
        "params": {
            "structure": "FullBoards",
            "board_id": "aaaaaaaa-0000-0000-0000-000000000001",
            "timestamp": 10
        }
    },
    "expected_response": {
        "id": "bdf-1",
        "ok": false,
        "error": {
            "code": "BOARD_FULL",
            "message_contains": "has 3 of 3 positions filled"
        }
    }
}
