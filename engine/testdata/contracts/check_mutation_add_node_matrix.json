{
    "description": "check_mutation has no check for a matrix add_node, which places by spillover",
    "setup": [
        {"id": "s-1", "op": "create_tree", "params": {"structure": "test", "tree_type": "matrix", "width": 3, "spillover": "breadth_first"}},
        {"id": "s-2", "op": "add_root", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 1000}}
    ],
    "request": {
        "id": "cm-11",
        "op": "check_mutation",
        "params": {"structure": "test", "mutation": "add_node", "user_id": "00000000-0000-0000-0000-000000000002", "sponsor_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 2000}
    },
    "expected_response": {"id": "cm-11", "ok": false, "error": {"code": "UNSUPPORTED_OP", "message_contains": "check_mutation does not cover add_node on matrix trees"}}
