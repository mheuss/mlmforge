{
    "description": "check_mutation passes a matrix add_root the tree would accept, answering checked rather than added",
    "setup": [
        {
            "id": "s-1",
            "op": "create_tree",
            "params": {
                "structure": "test",
                "tree_type": "matrix",
                "width": 3,
                "spillover": "breadth_first"
            }
        }
    ],
    "request": {
        "id": "cm-15",
        "op": "check_mutation",
        "params": {
            "structure": "test",
            "mutation": "add_root",
            "user_id": "00000000-0000-0000-0000-000000000001",
            "enrolled_at": 1000
        }
    },
    "expected_response": {
        "id": "cm-15",
        "ok": true,
        "result": {
            "checked": true
        }
    }
}
