{
    "description": "check_mutation refuses an add_root with the code add_root returns",
    "setup": [
        {"id": "s-1", "op": "create_tree", "params": {"structure": "test", "tree_type": "unilevel"}},
        {"id": "s-2", "op": "add_root", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 1000}}
    ],
    "request": {
        "id": "cm-2",
        "op": "check_mutation",
        "params": {"structure": "test", "mutation": "add_root", "user_id": "00000000-0000-0000-0000-000000000002", "enrolled_at": 2000}
    },
    "expected_response": {"id": "cm-2", "ok": false, "error": {"code": "ROOT_ALREADY_EXISTS"}}
}
