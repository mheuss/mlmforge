{
    "description": "place_from_tank refuses a position at or past the matrix width with INVALID_POSITION",
    "setup": [
        {"id": "s-1", "op": "create_tree", "params": {"structure": "test", "tree_type": "matrix", "width": 2, "spillover": "breadth_first"}},
        {"id": "s-2", "op": "add_root", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 1000}},
        {"id": "s-3", "op": "add_node", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000002", "sponsor_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 2000}},
        {"id": "s-4", "op": "add_node", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000003", "sponsor_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 3000}},
        {"id": "s-5", "op": "remove_node", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000003", "pruning_mode": "holding_tank"}}
    ],
    "request": {
        "id": "pf-invalid-position",
        "op": "place_from_tank",
        "params": {
            "structure": "test",
            "user_id": "00000000-0000-0000-0000-000000000003",
            "parent_id": "00000000-0000-0000-0000-000000000001",
            "position": 2
        }
    },
    "expected_response": {"id": "pf-invalid-position", "ok": false, "error": {"code": "INVALID_POSITION", "message_contains": "position 2 out of range for user 00000000-0000-0000-0000-000000000001"}}
}
