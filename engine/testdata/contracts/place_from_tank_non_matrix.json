{
    "description": "place_from_tank on a unilevel tree is refused with INVALID_PARAMS",
    "setup": [
        {"id": "s-1", "op": "create_tree", "params": {"structure": "test", "tree_type": "unilevel"}},
        {"id": "s-2", "op": "add_root", "params": {"structure": "test", "user_id": "00000000-0000-0000-0000-000000000001", "enrolled_at": 1000}}
    ],
    "request": {
        "id": "pf-non-matrix",
        "op": "place_from_tank",
        "params": {
            "structure": "test",
            "user_id": "00000000-0000-0000-0000-000000000003",
            "parent_id": "00000000-0000-0000-0000-000000000001",
            "position": 0
        }
    },
    "expected_response": {"id": "pf-non-matrix", "ok": false, "error": {"code": "INVALID_PARAMS", "message_contains": "only supported for matrix trees"}}
}
