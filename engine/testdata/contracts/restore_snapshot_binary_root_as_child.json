{
    "description": "restore_snapshot rejects a binary snapshot whose child slot map names the root as a child, with INCONSISTENT_SNAPSHOT. Cross-language lock for the HEU-750 slice 2 root check. Before it, the completeness walk skipped the root as a key and nothing rejected the root as a value, so this payload was accepted and count_branch then reported two nodes in the child's own leg of a two-node tree. The payload spells out the Arena and slot shapes by hand, so a new required field on Arena, Node or BinaryTree turns this into a deserialization failure rather than the rejection it tests.",
    "request": {
        "id": "rs-binary-root-as-child",
        "op": "restore_snapshot",
        "params": {
            "structure": "RestoredBinary",
            "tree_type": "binary",
            "data": {
                "arena": {
                    "nodes": [
                        {
                            "user_id": "11111111-1111-1111-1111-111111111111",
                            "parent": null,
                            "children": [1],
                            "sponsor": null,
                            "sponsored": [1],
                            "depth": 0,
                            "enrolled_at": 100
                        },
                        {
                            "user_id": "22222222-2222-2222-2222-222222222222",
                            "parent": 0,
                            "children": [],
                            "sponsor": 0,
                            "sponsored": [],
                            "depth": 1,
                            "enrolled_at": 200
                        }
                    ],
                    "index": {
                        "11111111-1111-1111-1111-111111111111": 0,
                        "22222222-2222-2222-2222-222222222222": 1
                    },
                    "free_list": [],
                    "root": 0
                },
                "slots": {
                    "0": [1, null],
                    "1": [0, null]
                }
            }
        }
    },
    "expected_response": {
        "id": "rs-binary-root-as-child",
        "ok": false,
        "error": {
            "code": "INCONSISTENT_SNAPSHOT",
            "message_contains": "names the root in one of its child slots"
        }
    }
