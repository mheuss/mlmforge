                            "parent": 0,
                            "children": [],
                            "sponsor": 0,
                            "sponsored": [],
                            "depth": 1,
                            "enrolled_at": 200
                        }
                    ],
                    "index": {
                        "11111111-1111-1111-1111-111111111111": 0,
                        "22222222-2222-2222-2222-222222222222": 1
                    },
                    "free_list": [],
                    "root": 0
                },
                "slots": {
                    "0": [null, null],
                    "1": [null, null]
                }
            }
        }
    },
    "expected_response": {
        "id": "rs-binary-unslotted",
