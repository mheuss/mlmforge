            "data": {
                "arena": {
                    "nodes": [
                        {
                            "user_id": "11111111-1111-1111-1111-111111111111",
                            "parent": null,
                            "children": [1],
                            "sponsor": null,
                            "sponsored": [1],
                            "depth": 0,
                            "enrolled_at": 100
                        },
                        {
