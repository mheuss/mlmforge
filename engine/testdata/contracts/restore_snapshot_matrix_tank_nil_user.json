{
    "description": "restore_snapshot rejects a matrix snapshot whose holding tank holds the nil UUID, with INCONSISTENT_SNAPSHOT. Cross-language lock for HEU-951. Before it, this payload restored and place_from_tank then refused the entry with NIL_USER_ID forever. The payload spells out the Arena, slot and tank shapes by hand. A new required field on Arena, Node, MatrixTree or HoldingTankEntry turns this into a deserialization failure rather than the rejection it tests.",
    "request": {
        "id": "rs-matrix-tank-nil-user",
        "op": "restore_snapshot",
        "params": {
            "structure": "RestoredMatrix",
            "tree_type": "matrix",
            "data": {
                "arena": {
                    "nodes": [
                        {
                            "user_id": "11111111-1111-1111-1111-111111111111",
                            "parent": null,
                            "children": [],
                            "sponsor": null,
                            "sponsored": [],
                            "depth": 0,
                            "enrolled_at": 100
                        }
                    ],
                    "index": {
                        "11111111-1111-1111-1111-111111111111": 0
                    },
                    "free_list": [],
                    "root": 0
                },
                "width": 2,
                "spillover": "breadth_first",
                "slots": {
                    "0": [null, null]
                },
                "holding_tank": [
                    {
                        "user_id": "00000000-0000-0000-0000-000000000000",
                        "sponsor_user_id": null,
                        "enrolled_at": 200
                    }
                ]
            }
        }
    },
    "expected_response": {
        "id": "rs-matrix-tank-nil-user",
        "ok": false,
        "error": {
            "code": "INCONSISTENT_SNAPSHOT",
            "message_contains": "holding tank entry 0 names the nil UUID"
        }
    }
}
