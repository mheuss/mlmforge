        "id": "rs-unknown-tree-type",
        "op": "restore_snapshot",
        "params": {
            "structure": "Restored",
            "tree_type": "ternary",
            "data": {}
        }
    },
    "expected_response": {
        "id": "rs-unknown-tree-type",
